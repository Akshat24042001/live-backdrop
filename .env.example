# Copy this file to .env. Keys can also be pasted in the operator panel (Engines & keys).

# AI that picks the highlights (choose the provider in the panel)
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Speech recognition (Browser speech needs no key)
GROQ_API_KEY=
SARVAM_API_KEY=
SONIOX_API_KEY=

# Password for the operator panel and the hidden settings on the backdrop. Change it.
CONTROL_KEY=jito

PORT=3000
