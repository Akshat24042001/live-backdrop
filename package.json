{
  "name": "live-backdrop",
  "version": "2.0.0",
  "description": "Live speech highlights for stage backdrops (LED walls, projectors, OBS/vMix).",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --demo",
